build/
dist/
AppDir/
*.spec.bak

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Runtime data
lapsecoin_chain.db
lapsecoin_chain.db-shm
lapsecoin_chain.db-wal
lapsecoin_key.json
lapsecoin.log
lapsecoin.log.*
lapsecoin.lock
*.dat

# json data
*.json

# Keys
*.key


# VSCode
.history/
build-nuitka/
nuitka-cache/
msi-work/
stage/
*.msi

# Seeded FALCON library (built by make -C native/falcon_seeded)
native/falcon_seeded/*.so
native/falcon_seeded/*.dylib
native/falcon_seeded/*.dll

