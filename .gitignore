# the /lapsecoin-WxHxext route generates.
lapsecoin.png
lapsecoin-*.png
lapsecoin-*.webp
lapsecoin-*.bmp
lapsecoin-*.ico
lapsecoin-*.jpg
lapsecoin-*.jpeg
favicon.ico

