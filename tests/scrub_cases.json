{
  "environment": {
    "USERNAME": "victor",
    "COMPUTERNAME": "VICPC",
    "USERDOMAIN": "VICDOM",
    "USERPROFILE": "C:\\Users\\victor",
    "LOCALAPPDATA": "C:\\Users\\victor\\AppData\\Local",
    "APPDATA": "C:\\Users\\victor\\AppData\\Roaming",
    "TEMP": "C:\\Users\\victor\\AppData\\Local\\Temp"
  },
  "cases": [
    {"name": "profile folders and account names",
     "in": "open C:\\Users\\victor\\LapseCoin\\x.json for victor on VICPC in VICDOM",
     "out": "open %USERPROFILE%\\LapseCoin\\x.json for <user> on <computer> in <domain>"},
    {"name": "longer folders first",
     "in": "C:\\Users\\victor\\AppData\\Local\\Temp\\a and C:\\Users\\victor\\AppData\\Roaming\\b",
     "out": "%TEMP%\\a and %APPDATA%\\b"},
    {"name": "another account's folder",
     "in": "C:\\Users\\someone-else\\Desktop\\x",
     "out": "%USERPROFILE%\\Desktop\\x"},
    {"name": "a whole address",
     "in": "send to abandon.ability.able.about.above.absent.absorb.abstract.absurd.abuse.access.accident now",
     "out": "send to <address> now"},
    {"name": "a cut-off address",
     "in": "bad abandon.ability.able.about prefix",
     "out": "bad <address> prefix"},
    {"name": "sealed account key",
     "in": "key lc1-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end",
     "out": "key <key> end"},
    {"name": "passphrase in a message",
     "in": "failed with passphrase=hunter2 next",
     "out": "failed with passphrase=<removed> next"},
    {"name": "passphrase in a dict",
     "in": "{'password': 'abc def', 'n': 1}",
     "out": "{'password': <removed>, 'n': 1}"},
    {"name": "a key given as an option value",
     "in": "key: 3f9a next",
     "out": "key: <removed> next"},
    {"name": "a long hex string",
     "in": "sig 3a7bd3e2360a3d29eea436fcfb7e44c8a5 end",
     "out": "sig <hex> end"},
    {"name": "short hex and hex numbers stay",
     "in": "code 0xc0000005 offset 0x0000000000008a54 stamp 0x15b851a4",
     "out": "code 0xc0000005 offset 0x0000000000008a54 stamp 0x15b851a4"},
    {"name": "base64 text",
     "in": "blob QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFB end",
     "out": "blob <token> end"},
    {"name": "a recovery phrase",
     "in": "phrase is abandon ability able about above absent absorb abstract absurd abuse access accident.",
     "out": "phrase is <words>."},
    {"name": "an ordinary short sentence stays",
     "in": "cannot open the log file",
     "out": "cannot open the log file"},
    {"name": "an IPv4 address and port",
     "in": "peer 203.0.113.7:8333 refused",
     "out": "peer <ip>:8333 refused"},
    {"name": "Windows versions are not IP addresses",
     "in": "version: 10.0.26100.9711 build 10.0.26200.9711",
     "out": "version: 10.0.26100.9711 build 10.0.26200.9711"},
    {"name": "an IPv6 address and loopback",
     "in": "from 2001:db8:85a3:0:0:8a2e:370:7334 and ::1 ok",
     "out": "from <ip> and <ip> ok"},
    {"name": "a clock time is not an IP address",
     "in": "at 07:10:51 and 7:1:2:3",
     "out": "at 07:10:51 and 7:1:2:3"},
    {"name": "an e-mail address",
     "in": "mail me@example.com now",
     "out": "mail <email> now"},
    {"name": "bytes",
     "in": "got b'\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08' here",
     "out": "got b'<bytes>' here"},
    {"name": "a native crash dump line is kept",
     "in": "Thread 0x00002bcc (most recent call first):\n  File \"C:\\PROGRA~1\\WindowsApps\\VICNAS~1.0_X\\gui.py\", line ??? in run_status_window",
     "out": "Thread 0x00002bcc (most recent call first):\n  File \"C:\\PROGRA~1\\WindowsApps\\VICNAS~1.0_X\\gui.py\", line ??? in run_status_window"},
    {"name": "a Windows error event keeps its facts",
     "in": "Faulting module name: combase.dll, version: 10.0.26100.9711\nException code: 0xc0000005\nFault offset: 0x0000000000008a54",
     "out": "Faulting module name: combase.dll, version: 10.0.26100.9711\nException code: 0xc0000005\nFault offset: 0x0000000000008a54"}
  ]
}
