<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user installer for LapseCoin (WiX Toolset 3). Built by
  scripts/build_msi.ps1; AppFiles.wxs, the list of files in the PyInstaller
  folder, is generated by heat at build time.

  Installs to %LOCALAPPDATA%\Programs\LapseCoin, which src/datadir.py
  installed_exe() and lapsecoin_bridge.py rely on. Needs no administrator
  rights. The node's data lives in %USERPROFILE%\LapseCoin and is never
  touched by installing, upgrading or uninstalling (older versions kept it in
  %LOCALAPPDATA%\LapseCoin, and the first run moves it, see src/datadir.py). Uninstalling with a
  window shows a notice saying so (src/uninstall_notice.py).

  LAUNCH=0 stops the installer from starting the app afterwards: the
  updater and the bridge start it themselves.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="LapseCoin" Language="1033" Version="$(var.Version)"
           Manufacturer="LapseCoin" UpgradeCode="48002B81-4A5D-4026-8DFA-603FE0817AAC">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="LapseCoin node and wallet" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of LapseCoin is already installed." />
    <!-- Windows 7 and older install it and then the program cannot load
         (api-ms-win-core-path-l1-1-0.dll and others are missing), which a crash report showed.
         602 is Windows 8, so this turns those away and nothing else. It cannot ask for
         Windows 10 (1000): on a Windows 11 runner the installer reported VersionNT 603 (8.1)
         and refused to install, so a newer Windows that is older than 10 is left to the
         launcher, which reads the real version when the program starts. -->
    <Condition Message="LapseCoin does not run on Windows 7 or older. It needs Windows 10 or newer.">Installed OR VersionNT &gt;= 602</Condition>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Stops a running LapseCoin before it is upgraded or removed. Without
         this, removing the program left the node running from memory, holding
         the lock and the chain database, so the next copy could not start or
         move the data. A node has no window to close, so after asking
         politely the process is ended; its database and wallet are written
         so that this is safe. -->
    <util:CloseApplication Id="CloseLapseCoin" Target="lapsecoin.exe"
                           CloseMessage="yes" RebootPrompt="no" TerminateProcess="1" />
    <util:CloseApplication Id="CloseLapseCoinLauncher" Target="lapsecoin-launch.exe"
                           CloseMessage="yes" RebootPrompt="no" TerminateProcess="1" />

    <Icon Id="lapsecoin.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="lapsecoin.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Lapsecoin/core" />
    <Property Id="LAUNCH" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="LapseCoin" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstalledMarker" Guid="*">
        <File Id="InstalledMarkerFile" Name="installed-by-msi" Source="$(var.Marker)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="LapseCoin" Description="LapseCoin node and wallet"
                  Target="[INSTALLFOLDER]lapsecoin-launch.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="lapsecoin.ico" />
        <RegistryValue Root="HKCU" Key="Software\LapseCoin" Name="shortcut" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="AppDesktopShortcut" Name="LapseCoin" Description="LapseCoin node and wallet"
                  Target="[INSTALLFOLDER]lapsecoin-launch.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="lapsecoin.ico" />
        <RegistryValue Root="HKCU" Key="Software\LapseCoin" Name="desktop_shortcut" Type="integer"
                       Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="LapseCoin" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="InstalledMarker" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]lapsecoin-launch.exe&quot;"
                  Return="asyncNoWait" />
    <!-- Shows where the wallet stays before the program is removed. Skipped
         for silent uninstalls and for upgrades, and it never fails them. -->
    <CustomAction Id="UninstallNotice" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]lapsecoin.exe&quot; --uninstall-notice"
                  Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="UninstallNotice" After="InstallInitialize">REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 3</Custom>
      <Custom Action="LaunchApp" After="InstallFinalize">LAUNCH = "1" AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
